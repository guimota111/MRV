# Configuração do Firebase Web (Console → Configurações do projeto → Seus apps).
# Copie este arquivo para .env.local e preencha. Estes valores são públicos por
# natureza — vão para o bundle do navegador. O que protege os dados são as
# Security Rules em firestore.rules e storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional. Sem isto, a URL das functions HTTP é montada como
# https://<regiao>-<projectId>.cloudfunctions.net/<function>.
# Preencha se você usa domínio próprio ou os emuladores locais
# (ex.: http://127.0.0.1:5001/seu-projeto/southamerica-east1).
NEXT_PUBLIC_FUNCTIONS_BASE_URL=

# A CHAVE DA ANTHROPIC NÃO VAI AQUI.
# Ela é uma secret das Cloud Functions:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
